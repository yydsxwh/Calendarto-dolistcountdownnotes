# 日事 BFF。密钥只放服务端，不要写进 Git / VITE_* / APK。
# 本文件给本地开发。生产必须在服务器环境文件里显式填写公网地址和数据目录。
DAYS_SYNC_HOST=127.0.0.1
DAYS_SYNC_PORT=3120
DAYS_SYNC_DATA_DIR=./data/kemiao-days
DAYS_SYNC_ALLOWED_ORIGINS=http://localhost:5173,https://localhost
RISHI_PUBLIC_ORIGIN=http://127.0.0.1:5173
RISHI_SESSION_SECRET=
ACCOUNT_ISSUER=
ACCOUNT_CLIENT_ID=rishi
ACCOUNT_CLIENT_SECRET=
ACCOUNT_REDIRECT_URI=
PLATFORM_API_URL=
PLATFORM_BASE_URL=
PLATFORM_SERVICE_TOKEN=
PLATFORM_CLIENT_ID=rishi
RISHI_ADMIN_SUBS=
RISHI_CONFIG_ENCRYPTION_KEY=
# 留空/设为 off 可关闭旧主站 OCR 回退；生产迁移时不要在源码里硬编码旧域名。
DAYS_OCR_FALLBACK_URL=
# 旧主站会话只用于一次性迁移旧数据。留空或设为 off 可完全关闭回源。
DAYS_SYNC_SESSION_URL=

# 原生客户端构建时使用。网页端优先使用当前页面 origin。
VITE_DAYS_API_ORIGIN=
VITE_ACCOUNT_URL=
VITE_SITE_ORIGIN=
CAPACITOR_ALLOW_NAVIGATION=
