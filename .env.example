# 颗秒日事 BFF —— 环境变量示例
#
# 复制为 .env 或 .env.local 后再填真实值。
#   cp .env.example .env
#
# 这里只能出现示例值。真实 Secret 绝不进入 Git、绝不出现在源码、
# 绝不带 VITE_ 前缀（带前缀的变量会被打进浏览器包）。
# .gitignore 已经忽略 .env / .env.* / *.pem / *.key / var/ / *.sqlite。

# ─────────────────────────────────────────────────────────────
# 账号中心（统一身份提供者，独立仓库、独立部署）
# ─────────────────────────────────────────────────────────────

# Issuer。所有 endpoint 由 ${ACCOUNT_ISSUER}/.well-known/openid-configuration
# 自动发现，不要在代码里硬编码 authorize / token / userinfo / jwks / revoke。
ACCOUNT_ISSUER="https://account.yydsxwh.com"

# 日事在账号中心 /studio/apps 登记的 client_id
ACCOUNT_CLIENT_ID="rishi"

# confidential client 密钥。只存在于服务端进程环境中。
# 未配置时日事可以启动，但 /api/auth/login 会返回 503——这是刻意的：
# 不会伪造一个假 secret 来假装接入成功。
ACCOUNT_CLIENT_SECRET="replace-with-the-real-secret-from-account-studio"

# 必须与账号中心登记的回调地址逐字符一致
ACCOUNT_REDIRECT_URI="https://rishi.yydsxwh.com/api/auth/callback"

# 申请的 scope。默认不含 offline_access：日事只在登录时取身份，
# 不需要长期持有 refresh token（见 docs/authentication.md 第 13 节）。
ACCOUNT_SCOPES="openid profile email"

# 客户端认证方式：client_secret_post（默认）/ client_secret_basic / none
# 跨库联调时按账号中心 token_endpoint_auth_methods_supported 核对。
ACCOUNT_CLIENT_AUTH_METHOD="client_secret_post"

# 是否用 JWKS 校验 ID Token 的 JWS 签名。默认 true。
# OIDC Core 3.1.3.7 允许 code flow 用 TLS 代替验签，日事选择真的验。
ACCOUNT_VERIFY_ID_TOKEN_SIGNATURE="true"

# discovery 文档缓存与失败退避（秒）
ACCOUNT_DISCOVERY_TTL_SECONDS="3600"
ACCOUNT_DISCOVERY_RETRY_SECONDS="30"

# 仅供本地对着 http:// 的测试 Provider 联调。生产环境设为 1 会拒绝启动。
ACCOUNT_ALLOW_INSECURE_HTTP="0"

# ─────────────────────────────────────────────────────────────
# 日事自己的会话
# ─────────────────────────────────────────────────────────────

# 日事 Session 专用高强度随机串，生产至少 32 字符。
# 必须与 ACCOUNT_CLIENT_SECRET 以及账号中心任何 Secret 完全不同，
# 配置相同时服务会拒绝启动。
# 生成：openssl rand -base64 48
RISHI_SESSION_SECRET="generate-with-openssl-rand-base64-48"

RISHI_SESSION_COOKIE_NAME="rishi_sid"
RISHI_SESSION_COOKIE_SECURE="true"
# 需要在 *.yydsxwh.com 之间共享会话时才设置，否则留空更安全
# RISHI_SESSION_COOKIE_DOMAIN=".yydsxwh.com"

# 绝对有效期与滑动空闲有效期（秒）
RISHI_SESSION_ABSOLUTE_TTL_SECONDS="2592000"
RISHI_SESSION_IDLE_TTL_SECONDS="1209600"

# ─────────────────────────────────────────────────────────────
# 服务与前端
# ─────────────────────────────────────────────────────────────

PORT="3100"
RISHI_APP_ORIGIN="https://rishi.yydsxwh.com"

# 额外可信来源，逗号分隔（Capacitor / Electron 外壳、主站页面等）
# RISHI_ALLOWED_ORIGINS="https://www.yydsxwh.com,capacitor://localhost,http://localhost"

RISHI_DEFAULT_RETURN_TO="/"
RISHI_DATABASE_FILE="var/rishi.sqlite"
RISHI_TRUST_PROXY="true"

# ─────────────────────────────────────────────────────────────
# 原生客户端登录交接
# ─────────────────────────────────────────────────────────────

RISHI_NATIVE_HANDOFF_ENABLED="true"
RISHI_NATIVE_SCHEME="com.yydsxwh.kemiao.days"
RISHI_NATIVE_HANDOFF_TTL_SECONDS="120"

# ─────────────────────────────────────────────────────────────
# Refresh Token（默认关闭）
# ─────────────────────────────────────────────────────────────

# 开启前必须在 ACCOUNT_SCOPES 里加 offline_access，否则拒绝启动。
# 开启后 refresh token 以 AES-256-GCM 密文存库，只在服务端使用。
RISHI_STORE_REFRESH_TOKENS="false"

# ─────────────────────────────────────────────────────────────
# 前端（VITE_ 前缀会被打进浏览器包，只能放非机密值）
# ─────────────────────────────────────────────────────────────

# 网页版与 BFF 同源时留空即可；Android / iOS / Electron 外壳需要绝对地址。
# VITE_RISHI_API_BASE="https://rishi.yydsxwh.com"

RISHI_LOG_LEVEL="info"
