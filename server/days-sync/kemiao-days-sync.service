[Unit]
Description=颗秒日事 云同步服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/kemiao-days-sync/index.mjs
Environment=DAYS_SYNC_PORT=3120
Environment=DAYS_SYNC_HOST=127.0.0.1
Environment=DAYS_SYNC_DATA_DIR=/var/lib/kemiao-days
Environment=ACCOUNT_CLIENT_ID=rishi
# 站点地址、Account issuer、回调和允许的来源只放 EnvironmentFile。
# 不要把某一台机器的域名写进这个单元，否则同一份文件不能在另一台机器上用。
# 替换线上单元之前，确认 /etc/kemiao-days-sync.env 已经有这些键。
EnvironmentFile=-/etc/kemiao-days-sync.env
Restart=always
RestartSec=3

# 这个服务只需要读自己的代码和写自己的数据目录，其余一律不给。
User=www-data
Group=www-data
StateDirectory=kemiao-days
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kemiao-days
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
